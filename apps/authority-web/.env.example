# Authority-web owns its Better Auth handler at /api/auth. Keep these settings
# in this app; no AUTH_SERVICE_URL or Express auth proxy is required.
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# AWS S3 (shared `profile` bucket — worker avatar assignment)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=

# Public MapLibre-compatible style. Override coordinates for your authority's
# operational area; do not put provider secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_DEFAULT_LAT=20.2961
NEXT_PUBLIC_MAP_DEFAULT_LNG=85.8245

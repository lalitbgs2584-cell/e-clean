# Core services — copy these exact shared values to authority-web/.env.
NODE_ENV=development
PORT=7000
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_URL=http://localhost:7000
BETTER_AUTH_SECRET=replace-with-one-long-random-secret-used-by-every-server
REDIS_URL=redis://localhost:6379

# Optional integrations
OPENAI_API_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Single CDN domain in front of the S3 bucket (serves reports/, cleanups/, profiles/)
CLOUDFRONT_DOMAIN=
